# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set true in production (HTTPS only cookies, HSTS, redirect to HTTPS).
DJANGO_SECURE=false

# PostgreSQL. Docker Compose overrides the host to "db".
DATABASE_URL=postgres://forum:forum@localhost:5432/forum
POSTGRES_USER=forum
POSTGRES_PASSWORD=forum
POSTGRES_DB=forum

# Fernet keys for encrypted identity fields, comma-separated, newest first.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Seeded Owner account (used by `manage.py seed` only when the Owner does not exist yet).
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Owner

# The forum's address, used in links inside emails.
SITE_URL=http://localhost:8000

# Email. The console backend prints mail to stdout in development.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=forum@example.com

# S3-compatible object storage (attachments, exports). Signed URLs only.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The object store's origin (for example https://bucket.s3.example.com), so the content security
# policy lets signed attachment URLs load as images. Space-separated if more than one.
CSP_EXTRA_IMG_SRC=

# Session binding: path to a country database in MaxMind DB format, kept on this server (MaxMind
# GeoLite2 Country or DB-IP Lite Country; follow their licence terms and update it monthly). Leave
# empty in development: countries are then unknown and the concurrent-location check never fires.
GEOIP_COUNTRY_DATABASE=
# The reverse proxy or load balancer in front of the forum, if any (space-separated addresses). Only
# these may supply the client address in X-Forwarded-For.
TRUSTED_PROXIES=

# Watermarking: two zero-width characters as hex code points (0 then 1; never 200C or 200D), and
# how many words apart the marks go in post bodies and DM messages.
WATERMARK_CODEPOINTS=200B,2060
WATERMARK_EVERY_WORDS=12

# A supplied logo, as paths under the static files: SITE_LOGO for the masthead (any image) and
# SITE_ICON for the home-screen icons (a square PNG, at least 512 pixels). Empty uses the wordmark
# and the generated initials.
SITE_LOGO=
SITE_ICON=

# Stripe. Prices are created in Stripe and referred to by id: membership ($25 a year), a gifted first
# year, and each paid extra (the setting named by the extra's stripe_price_setting).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBERSHIP=
STRIPE_PRICE_GIFT=
STRIPE_PRICE_AVATAR_CAPTION=
STRIPE_PRICE_CUSTOM_EMOJI=
